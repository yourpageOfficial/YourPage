# Application
APP_ENV=development
APP_PORT=8080
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=admin@yourpage.id
ADMIN_PASSWORD=adminpassword123

# Swagger UI (true | false) - Default: true in dev, false in production
ENABLE_SWAGGER=true

# Database
DATABASE_URL=postgres://dev:dev@localhost:5432/yourpage?sslmode=disable

# Redis
REDIS_URL=localhost:6379

# JWT
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# MinIO Storage
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_PUBLIC_BUCKET=yourpage-public
MINIO_PRIVATE_BUCKET=yourpage-private

# Payment Gateways
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# SMTP Mailer
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourpage.id

# Platform Settings Defaults
PLATFORM_FEE_PERCENT=20
MIN_WITHDRAWAL_IDR=100000
CREDIT_RATE_IDR=1000
MAX_UPLOAD_SIZE_MB=500
