# ==============================================================================
# YourPage Production Environment Configuration Template
# Copy this file to .env.production on the production host
# ==============================================================================

# ─── Domain & Host ────────────────────────────────────────────────────────────
DOMAIN=urpage.online
APP_ENV=production
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_URL=https://urpage.online

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_USER=yourpage
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD_64_CHARS
DB_NAME=yourpage

# ─── Cache & PubSub (Redis) ───────────────────────────────────────────────────
REDIS_PASSWORD=REPLACE_WITH_STRONG_RANDOM_REDIS_PASSWORD_64_CHARS

# ─── MinIO Object Storage ────────────────────────────────────────────────────
MINIO_USER=minioadmin
MINIO_PASSWORD=REPLACE_WITH_STRONG_RANDOM_MINIO_PASSWORD_64_CHARS

# ─── Authentication & JWT ────────────────────────────────────────────────────
# Must be at least 32 cryptographically secure random bytes
JWT_SECRET=REPLACE_WITH_HEX_OR_BASE64_JWT_SECRET_32_BYTES_MINIMUM

# ─── Initial Admin Credentials ───────────────────────────────────────────────
ADMIN_EMAIL=admin@yourpage.id
ADMIN_PASSWORD=REPLACE_WITH_INITIAL_ADMIN_PASSWORD_STRONG

# ─── SMTP Email Delivery ─────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=REPLACE_WITH_SENDGRID_OR_RESEND_API_KEY
SMTP_FROM="YourPage <noreply@yourpage.id>"

# ─── Payment Gateways (Production) ───────────────────────────────────────────
XENDIT_SECRET_KEY=xnd_production_...
XENDIT_WEBHOOK_TOKEN=...
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_MODE=live

# ─── Monitoring & Observability ──────────────────────────────────────────────
GRAFANA_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD
SENTRY_DSN=https://...
NEXT_PUBLIC_SENTRY_DSN=https://...
# === YourPage Production Environment ===
# Copy to .env and fill in values

# Domain
DOMAIN=yourpage.id

# Database
DB_USER=yourpage
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_1
DB_NAME=yourpage

# Redis
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD_2

# JWT
JWT_SECRET=CHANGE_ME_RANDOM_64_CHARS

# MinIO
MINIO_USER=minioadmin
MINIO_PASSWORD=CHANGE_ME_STRONG_PASSWORD_3

# Grafana
GRAFANA_PASSWORD=CHANGE_ME_STRONG_PASSWORD_4

# Admin (created on first startup)
ADMIN_EMAIL=admin@urpage.online
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_5

# SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=YourPage <noreply@urpage.online>
